# Aplika local development defaults.
# These values are not secrets; they are committed on purpose so `docker compose up -d`
# works out of the box. Override them locally with a `.env.local` file when needed.
COMPOSE_PROJECT_NAME=aplika

APP_UID=1000
APP_GID=1000

API_PORT=80
FRONTEND_PORT=3000

FRONTEND_DOMAIN=aplika.test
API_DOMAIN=api.aplika.test

POSTGRES_DB=aplika
POSTGRES_USER=aplika
POSTGRES_PASSWORD=aplika
POSTGRES_PORT=5432

# Xdebug: set to "debug" to enable step debugging, "off" to disable (default).
XDEBUG_MODE=off

# Frontend debug: set to "debug" to start Next.js with Node inspector on port 9229.
FRONTEND_SCRIPT=dev
