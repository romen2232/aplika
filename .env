# Joblog local development defaults.
# These values are not secrets; they are committed on purpose so `docker compose up -d`
# works out of the box. Override them locally with a `.env.local` file when needed.
COMPOSE_PROJECT_NAME=joblog

APP_UID=1000
APP_GID=1000

API_PORT=8000
FRONTEND_PORT=3000

POSTGRES_DB=joblog
POSTGRES_USER=joblog
POSTGRES_PASSWORD=joblog
POSTGRES_PORT=5432
