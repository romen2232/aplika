#!/usr/bin/env sh

set -e

echo "🔍 Running pre-push checks..."
echo ""

# --- Lint phase: check, auto-fix, commit if needed ---
lint_failed=0

echo "📦 Backend: Linting..."
make lint-backend || lint_failed=1

echo "🎨 Frontend: Linting..."
make lint-frontend || lint_failed=1

if [ "$lint_failed" -eq 1 ]; then
  echo ""
  echo "⚠️  Lint issues found. Attempting auto-fix..."
  echo ""

  # Fix backend (PHP-CS-Fixer)
  make php-cs-fixer-fix 2>/dev/null || true

  # Fix frontend (ESLint + Prettier)
  make lint-frontend-fix 2>/dev/null || true

  # Check if any files were actually changed
  if [ -n "$(git diff --name-only)" ]; then
    echo ""
    echo "📝 Committing lint fixes..."
    git add -A
    git commit -m "style: pre-push lint changes"
  fi

  # Re-run lint to verify fixes resolved the issues
  echo ""
  echo "🔄 Re-running lint checks..."
  make lint-backend || { echo "❌ Backend lint still failing after fix"; exit 1; }
  make lint-frontend || { echo "❌ Frontend lint still failing after fix"; exit 1; }
fi

# --- Remaining checks ---
echo "📦 Backend: Running unit tests..."
make test-phpspec || { echo "❌ Backend unit tests failed"; exit 1; }

echo "🎨 Frontend: Type checking..."
make typecheck || { echo "❌ Frontend type check failed"; exit 1; }

echo "🎨 Frontend: Running unit tests..."
make test-frontend || { echo "❌ Frontend unit tests failed"; exit 1; }

echo ""
echo "✅ All pre-push checks passed"
